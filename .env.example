# Paths. Relative paths resolve against the current working directory.
OPSDECK_SKILLS_ROOTS=examples/ops/skills
OPSDECK_RUNTIME_CONFIG=configs/runtime.json
OPSDECK_MODEL_CONFIG=configs/model.json
OPSDECK_CONNECTORS_CONFIG=examples/ops/configs/connectors.json
OPSDECK_SCHEMAS_DIR=schemas
OPSDECK_SCENARIOS_DIR=examples/ops/scenarios
OPSDECK_STATE_DIR=state

# Model provider selection: openai_compatible | scripted | none
OPSDECK_PROVIDER=none

# Model provider access. Overrides the values in configs/model.json.
# Any endpoint that speaks the chat-completions protocol works here.
OPSDECK_MODEL_BASE_URL=https://your-provider.example/v1
OPSDECK_MODEL_API_KEY=
OPSDECK_MODEL_CHAT=chat-model-name
OPSDECK_MODEL_EMBEDDING=embedding-model-name
