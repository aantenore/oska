# Paths. Relative paths resolve against the current working directory.
OSKA_SKILLS_ROOTS=examples/ops/skills
# The runtime and model configuration, the guardrail catalog and the schemas
# are read from here when these are set, else from configs/ and schemas/ in
# the working directory, else from the defaults shipped with the package.
OSKA_RUNTIME_CONFIG=configs/runtime.json
OSKA_MODEL_CONFIG=configs/model.json
# OSKA_GUARDRAILS_CATALOG=configs/guardrails.json
OSKA_CONNECTORS_CONFIG=examples/ops/configs/connectors.json
OSKA_SCHEMAS_DIR=schemas
OSKA_SCENARIOS_DIR=examples/ops/scenarios
OSKA_STATE_DIR=state

# Model provider selection: openai_compatible | scripted | none
OSKA_PROVIDER=none

# Model provider access. Overrides the values in configs/model.json.
# Any endpoint that speaks the chat-completions protocol works here.
OSKA_MODEL_BASE_URL=https://your-provider.example/v1
OSKA_MODEL_API_KEY=
OSKA_MODEL_CHAT=chat-model-name
OSKA_MODEL_EMBEDDING=embedding-model-name

# A platform manifest serving several domains, instead of one catalog.
# OSKA_PLATFORM=platform.yaml

# Only when storage.backend is postgres in configs/runtime.json.
# OSKA_DATABASE_URL=postgresql://user:password@host:5432/oska

# Only when catalog.signing.signer is set: the key revisions are signed with.
# OSKA_REVISION_KEY=

# Only when identity.mode is token: the key session tokens are verified with.
# OSKA_SESSION_TOKEN_KEY=
