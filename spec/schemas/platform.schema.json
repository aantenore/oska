{
  "$defs": {
    "ChannelSpec": {
      "description": "Which channels a platform opens.",
      "properties": {
        "cli": {
          "default": true,
          "title": "Cli",
          "type": "boolean"
        },
        "http": {
          "default": true,
          "title": "Http",
          "type": "boolean"
        }
      },
      "title": "ChannelSpec",
      "type": "object"
    },
    "DomainSpec": {
      "description": "One scope a platform answers in: its packs, its host and its tenants.\n\nA session belongs to one domain for its whole life. A skill of one domain is\nnever ranked, offered or executed in another. `environment` is what the\nbindings of the domain's packs may read from the environment.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "packs": {
          "items": {
            "type": "string"
          },
          "title": "Packs",
          "type": "array"
        },
        "host": {
          "$ref": "#/$defs/HostIdentity"
        },
        "tenants": {
          "items": {
            "type": "string"
          },
          "title": "Tenants",
          "type": "array"
        },
        "presentation": {
          "default": false,
          "title": "Presentation",
          "type": "boolean"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentSpec"
        }
      },
      "required": [
        "name",
        "packs",
        "host"
      ],
      "title": "DomainSpec",
      "type": "object"
    },
    "EnvironmentSpec": {
      "description": "Which environment variables a set of bindings may read with `${NAME}`.\n\n`names` admits each variable it lists; `prefix`, when set, admits every\nvariable whose name starts with it. A platform binding that reads any other\nvariable is refused when the platform is assembled. Nothing declared means\nnothing may be read.",
      "properties": {
        "names": {
          "items": {
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        },
        "prefix": {
          "default": "",
          "title": "Prefix",
          "type": "string"
        }
      },
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "HostIdentity": {
      "description": "Who the runtime answers as in a domain. Declared, never inferred.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "voice": {
          "default": "",
          "title": "Voice",
          "type": "string"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "HostIdentity",
      "type": "object"
    },
    "PackRef": {
      "description": "A pack a platform deploys: where it is, and the version it expects.",
      "properties": {
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "version": {
          "default": "*",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "PackRef",
      "type": "object"
    },
    "StorageSpec": {
      "description": "Where sessions and receipts are kept. The address comes from the environment.",
      "properties": {
        "backend": {
          "default": "sqlite",
          "enum": [
            "sqlite",
            "postgres"
          ],
          "title": "Backend",
          "type": "string"
        },
        "url_env": {
          "default": "OSKA_DATABASE_URL",
          "title": "Url Env",
          "type": "string"
        }
      },
      "title": "StorageSpec",
      "type": "object"
    },
    "TenantSpec": {
      "description": "What a platform manifest declares about one tenant.\n\n`environment` is what the tenant's own binding changes may read: the\n`base_url` and `headers` its overlay puts on a binding a pack declares.",
      "properties": {
        "environment": {
          "$ref": "#/$defs/EnvironmentSpec"
        }
      },
      "title": "TenantSpec",
      "type": "object"
    }
  },
  "description": "Contents of `platform.yaml`: what an organization deploys.\n\n`tenants` declares, per tenant a domain serves, what that tenant may read\nfrom the environment; a tenant it does not name reads nothing.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "packs": {
      "additionalProperties": {
        "$ref": "#/$defs/PackRef"
      },
      "title": "Packs",
      "type": "object"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/DomainSpec"
      },
      "title": "Domains",
      "type": "array"
    },
    "default_domain": {
      "default": "",
      "title": "Default Domain",
      "type": "string"
    },
    "channels": {
      "$ref": "#/$defs/ChannelSpec"
    },
    "storage": {
      "$ref": "#/$defs/StorageSpec"
    },
    "target_level": {
      "default": 2,
      "maximum": 3,
      "minimum": 1,
      "title": "Target Level",
      "type": "integer"
    },
    "tenants": {
      "additionalProperties": {
        "$ref": "#/$defs/TenantSpec"
      },
      "title": "Tenants",
      "type": "object"
    }
  },
  "required": [
    "name",
    "packs",
    "domains"
  ],
  "title": "PlatformManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oska.spec/schemas/platform.schema.json"
}
