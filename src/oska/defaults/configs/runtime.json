{
  "discovery": {
    "min_score": 0.2,
    "tie_margin": 0.05,
    "limit": 5,
    "exclude_types": [
      "composite"
    ],
    "languages": [
      "en",
      "it"
    ]
  },
  "router": {
    "rules": {
      "approve_tokens": [
        "yes",
        "y",
        "approve",
        "approved",
        "confirm",
        "confirmed",
        "ok",
        "okay",
        "go ahead",
        "si",
        "s\u00ec",
        "conferma",
        "confermo",
        "approva",
        "procedi",
        "va bene",
        "s\u00ed",
        "oui",
        "ja"
      ],
      "reject_tokens": [
        "no",
        "reject",
        "rejected",
        "cancel",
        "stop",
        "abort",
        "do not",
        "don't",
        "annulla",
        "rifiuta",
        "ferma",
        "interrompi",
        "no grazie",
        "non",
        "nein"
      ],
      "cancel_tokens": [
        "cancel",
        "stop",
        "abort",
        "never mind",
        "nevermind",
        "forget it",
        "drop it",
        "annulla",
        "lascia stare",
        "lascia perdere",
        "non importa",
        "fermati"
      ]
    },
    "fast_path": {
      "enabled": true,
      "threshold": 0.75,
      "routes": {
        "greeting": [
          "hello",
          "hi",
          "hey",
          "good morning",
          "good afternoon",
          "good evening",
          "ciao",
          "salve",
          "buongiorno",
          "buonasera"
        ]
      }
    }
  },
  "ledger": {
    "path": "state/ledger.sqlite"
  },
  "audit": {
    "path": "state/audit.jsonl"
  },
  "sessions": {
    "path": "state/sessions.sqlite"
  },
  "reply": {
    "default_language": "en",
    "conversation_window": 6,
    "phrases": "configs/phrases.json"
  },
  "learning": {
    "publish_root": "state/skills"
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "guardrails": {
    "enabled": true,
    "catalog": "configs/guardrails.json"
  },
  "tracing": {
    "enabled": false,
    "path": "state/traces.jsonl"
  },
  "turn": {
    "max_model_calls": 4
  },
  "enrichment": {
    "enabled": false,
    "per_language": 3,
    "cap_per_route": 24,
    "filename": "generated-examples.json"
  },
  "improvement": {
    "learned_root": "state/learned",
    "report_path": "state/improvement.json",
    "max_phrases_per_skill": 24,
    "cluster_threshold": 0.8,
    "cluster_min_size": 3,
    "bounds": {
      "min_score": [
        0.1,
        0.5
      ],
      "tie_margin": [
        0.02,
        0.15
      ]
    }
  },
  "catalog": {
    "revisions_root": "state/revisions",
    "revision": "",
    "tenant": "default",
    "pin_sessions": true,
    "mode": "directory",
    "signing": {
      "signer": "",
      "key_env": "OSKA_REVISION_KEY",
      "required": false
    }
  },
  "changes": {
    "root": "state/changes"
  },
  "resilience": {
    "timeout_seconds": 30.0,
    "failures_before_open": 3,
    "recovery_seconds": 30.0,
    "retries": 0,
    "backoff_seconds": 0.5,
    "retry_statuses": [
      502,
      503,
      504
    ],
    "max_response_bytes": 1000000
  },
  "retention": {
    "days": 0
  },
  "storage": {
    "busy_timeout_seconds": 10.0,
    "backend": "sqlite",
    "url_env": "OSKA_DATABASE_URL"
  },
  "identity": {
    "mode": "proxy",
    "key_env": "OSKA_SESSION_TOKEN_KEY",
    "required_claims": [
      "sub",
      "sid",
      "exp"
    ],
    "tenant_claim": "tenant",
    "tenant_header": "",
    "leeway_seconds": 30,
    "reviewer_role": "reviewer",
    "single_user": true,
    "proxy_secret_env": "",
    "proxy_secret_header": "X-Proxy-Secret"
  },
  "evaluation": {
    "min_precision": 1.0,
    "min_recall": 1.0,
    "require_sets": false
  },
  "metrics": {
    "enabled": true,
    "cache_seconds": 15.0,
    "public": false
  },
  "platform": {
    "cache_size": 16
  }
}
