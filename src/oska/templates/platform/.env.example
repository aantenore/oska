# ${platform}: environment overrides. Copy this file to .env and fill it in;
# .env is never committed. Paths are relative to the platform directory.

# The platform manifest this deployment serves. `oska`'s platform-aware
# commands read it directly; this variable is here for any script or
# supervisor that starts the runtime without naming it on the command line.
OSKA_PLATFORM=platform.yaml

# Configuration shared by every domain. Each file is read from configs/ when
# it is there and from the defaults shipped with the runtime otherwise; set a
# variable only to read it from somewhere else. The schemas ship with the
# runtime, so OSKA_SCHEMAS_DIR stays unset unless you keep schemas of your own.
# OSKA_RUNTIME_CONFIG=configs/runtime.json
# OSKA_MODEL_CONFIG=configs/model.json
# OSKA_GUARDRAILS_CATALOG=configs/guardrails.json
# OSKA_SCHEMAS_DIR=schemas
OSKA_STATE_DIR=state

# A single pack, for commands that read one catalog directly rather than the
# whole platform (`oska validate`, `oska pack check`, ...). Add one
# OSKA_SKILLS_ROOTS entry per pack you deploy, separated by commas.
OSKA_SKILLS_ROOTS=packs/${pack}/skills
OSKA_CONNECTORS_CONFIG=packs/${pack}/configs/connectors.json
OSKA_SCENARIOS_DIR=packs/${pack}/scenarios

# Model provider selection: openai_compatible | scripted | none
OSKA_PROVIDER=none

# Model provider access. Overrides the values in configs/model.json. Any
# endpoint that speaks the chat-completions protocol works here.
OSKA_MODEL_BASE_URL=https://your-provider.example/v1
OSKA_MODEL_API_KEY=
OSKA_MODEL_CHAT=chat-model-name
OSKA_MODEL_EMBEDDING=embedding-model-name

# The key session tokens are verified with, when configs/runtime.json's
# identity.mode is token. A long random value; see "Who can talk to it" in
# README.md. Unused in proxy mode.
# OSKA_SESSION_TOKEN_KEY=

# Database, when configs/runtime.json's storage.backend is postgres.
OSKA_DATABASE_URL=
