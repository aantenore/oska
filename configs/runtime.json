{
  "discovery": {
    "min_score": 0.2,
    "tie_margin": 0.05,
    "limit": 5,
    "exclude_types": ["composite"]
  },
  "router": {
    "rules": {
      "approve_tokens": [
        "yes", "y", "approve", "approved", "confirm", "confirmed", "ok", "okay", "go ahead",
        "si", "sì", "conferma", "confermo", "approva", "procedi", "va bene"
      ],
      "reject_tokens": [
        "no", "reject", "rejected", "cancel", "stop", "abort", "do not", "don't",
        "annulla", "rifiuta", "ferma", "interrompi", "no grazie"
      ],
      "cancel_tokens": [
        "cancel", "stop", "abort", "never mind", "nevermind", "forget it", "drop it",
        "annulla", "lascia stare", "lascia perdere", "non importa", "fermati"
      ]
    },
    "fast_path": {
      "enabled": true,
      "threshold": 0.75,
      "routes": {
        "greeting": [
          "hello",
          "hi",
          "hey",
          "good morning",
          "good afternoon",
          "good evening",
          "ciao",
          "salve",
          "buongiorno",
          "buonasera"
        ]
      }
    }
  },
  "ledger": {
    "path": "state/ledger.sqlite"
  },
  "audit": {
    "path": "state/audit.jsonl"
  },
  "sessions": {
    "path": "state/sessions.sqlite"
  },
  "reply": {
    "default_language": "en",
    "conversation_window": 6
  },
  "learning": {
    "publish_root": "state/skills"
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8000
  }
}
