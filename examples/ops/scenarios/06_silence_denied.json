            "write": false,
            "purpose": "find the alert that is firing"
          },
          {
            "integration_id": "integration.alerting",
            "operation": "alert.silence",
            "payload": {
              "alert_id": "alt-9001",
              "minutes": 480
            },
            "write": true,
            "purpose": "silence the alert for the requested time"
          }
