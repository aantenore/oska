{
  "name": "03_restart_production",
  "description": "A production restart needs two approvals; the first one only records that it was given.",
  "level": 2,
  "provider_script": [
    {
      "purpose": "router classification",
      "expect_contains": "the checkout service in production has to go down and come back up",
      "response": {
        "kind": "new_task",
        "runbook_id": "runbook.service_restart",
        "confidence": 0.9,
        "language": "en"
      }
    },
    {
      "purpose": "plan",
      "expect_contains": "in production",
      "response": {
        "runbook_id": "runbook.service_restart",
        "operations": [
          {
            "integration_id": "integration.container_runtime",
            "operation": "service.status",
            "payload": {
              "service": "checkout"
            },
            "write": false,
            "purpose": "read the current state"
          },
          {
            "integration_id": "integration.container_runtime",
            "operation": "service.restart",
            "payload": {
              "service": "checkout"
            },
            "write": true,
            "purpose": "restart the service in production"
          }
        ],
        "missing": [],
        "reply_intent": "report the production restart of checkout and its read-back"
      }
    },
    {
      "purpose": "reply writing",
      "expect_contains": "\"kind\": \"receipt\"",
      "response": {
        "reply": "checkout has been restarted in production and the read-back shows it running, so the receipt is verified."
      }
    }
  ],
  "turns": [
    {
      "user": "the checkout service in production has to go down and come back up",
      "expect": {
        "kind": "new_task",
        "contains": [
          "{\"service\":\"checkout\"}",
          "1 of 2"
        ],
        "outcomes": [
          "read",
          "approval_pending"
        ],
        "pending": "approval",
        "receipts": 0,
        "verification": null
      }
    },
    {
      "user": "yes",
      "expect": {
        "kind": "approve",
        "contains": [
          "1 of 2 approvals recorded"
        ],
        "outcomes": [
          "approval_pending"
        ],
        "pending": "approval",
        "receipts": 0,
        "verification": null
      }
    },
    {
      "user": "yes",
      "expect": {
        "kind": "approve",
        "contains": [
          "restarted",
          "verified"
        ],
        "outcomes": [
          "receipt"
        ],
        "pending": null,
        "receipts": 1,
        "verification": "verified"
      }
    }
  ]
}
