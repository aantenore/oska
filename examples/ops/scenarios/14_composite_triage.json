{
  "name": "14_composite_triage",
  "description": "A composite runs its procedures in order; the last one asks the person for the words of the note, and the write still stops for its own approval.",
  "level": 2,
  "provider_script": [
    {
      "purpose": "router classification",
      "expect_contains": "run triage on incident inc-501 for the payments service",
      "response": {
        "kind": "new_task",
        "runbook_id": "composite.incident_triage",
        "confidence": 0.9,
        "language": "en"
      }
    },
    {
      "purpose": "plan step 1, service health",
      "expect_contains": "run triage on incident",
      "response": {
        "runbook_id": "runbook.service_health",
        "operations": [
          {
            "integration_id": "integration.container_runtime",
            "operation": "service.status",
            "payload": {
              "service": "payments"
            },
            "write": false,
            "purpose": "read the state of the service"
          },
          {
            "integration_id": "integration.container_runtime",
            "operation": "service.logs",
            "payload": {
              "service": "payments",
              "lines": 50
            },
            "write": false,
            "purpose": "read the tail of the log"
          }
        ],
        "missing": [],
        "reply_intent": "report the health of payments"
      }
    },
    {
      "purpose": "plan step 2, log search",
      "expect_contains": "run triage on incident",
      "response": {
        "runbook_id": "runbook.log_search",
        "operations": [
          {
            "integration_id": "integration.container_runtime",
            "operation": "service.logs",
            "payload": {
              "service": "payments",
              "pattern": "timeout",
              "lines": 200
            },
            "write": false,
            "purpose": "find the lines behind the incident"
          }
        ],
        "missing": [],
        "reply_intent": "report the matching log lines"
      }
    },
    {
      "purpose": "plan step 3, incident note, which asks for the words of the note",
      "expect_contains": "run triage on incident",
      "response": {
        "runbook_id": "runbook.incident_note",
        "operations": [],
        "missing": [
          {
            "field": "note",
            "question": "What should the note on inc-501 say?"
          }
        ],
        "reply_intent": "ask what the note on inc-501 should say"
      }
    },
    {
      "purpose": "router classification of the answer",
      "expect_contains": "repeated connection pool timeouts",
      "response": {
        "kind": "provide_input",
        "runbook_id": "composite.incident_triage",
        "confidence": 0.9,
        "language": "en"
      }
    },
    {
      "purpose": "plan step 3 again, with the words the person gave",
      "expect_contains": "Inputs already collected",
      "response": {
        "runbook_id": "runbook.incident_note",
        "operations": [
          {
            "integration_id": "integration.incident_tracker",
            "operation": "incident.get",
            "payload": {
              "incident_id": "inc-501"
            },
            "write": false,
            "purpose": "read the incident before writing to it"
          },
          {
            "integration_id": "integration.incident_tracker",
            "operation": "incident.note",
            "payload": {
              "incident_id": "inc-501",
              "note": "payments is degraded on 3.2.0, the log shows repeated connection pool timeouts, triage started"
            },
            "write": true,
            "purpose": "record the words the person dictated"
          }
        ],
        "missing": [],
        "reply_intent": "report the note written on inc-501"
      }
    },
    {
      "purpose": "reply writing",
      "expect_contains": "\"kind\": \"receipt\"",
      "response": {
        "reply": "The triage note is on inc-501 and reading the incident back shows it as the most recent entry."
      }
    }
  ],
  "turns": [
    {
      "user": "run triage on incident inc-501 for the payments service",
      "expect": {
        "kind": "new_task",
        "contains": [
          "What should the note on inc-501 say?"
        ],
        "outcomes": [
          "read",
          "read",
          "read"
        ],
        "pending": "input",
        "receipts": 0,
        "verification": null
      }
    },
    {
      "user": "payments is degraded on 3.2.0, the log shows repeated connection pool timeouts, triage started",
      "expect": {
        "kind": "provide_input",
        "contains": [
          "incident.note",
          "inc-501",
          "repeated connection pool timeouts"
        ],
        "outcomes": [
          "read",
          "approval_pending"
        ],
        "pending": "approval",
        "receipts": 0,
        "verification": null
      }
    },
    {
      "user": "yes",
      "expect": {
        "kind": "approve",
        "contains": [
          "inc-501"
        ],
        "outcomes": [
          "receipt"
        ],
        "pending": null,
        "receipts": 1,
        "verification": "verified"
      }
    }
  ]
}
